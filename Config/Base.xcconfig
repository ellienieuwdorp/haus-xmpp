// Build settings shared by every target. Machine-specific values go in Config/Local.xcconfig, which is
// gitignored and included last so it overrides this file. See Config/Local.xcconfig.example.

// The Apple developer team for device builds. Empty works for the simulator.
DEVELOPMENT_TEAM =

// The version every bundle carries: both apps and both notification extensions, which must match their app.
// Raise CURRENT_PROJECT_VERSION for each App Store Connect upload (a version can't reuse a build number), or
// pass it on the command line: xcodebuild archive ... CURRENT_PROJECT_VERSION=42
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Domain of an optional hosted test server (Debug builds: the `-staging` launch argument). Empty turns the
// staging mode off.
HAUS_STAGING_DOMAIN =

#include? "Local.xcconfig"
