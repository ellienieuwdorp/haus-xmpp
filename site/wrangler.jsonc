// Static site for xmpp.haus, served from Cloudflare Workers static assets (no Worker code).
{
  "name": "haus-xmpp-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "xmpp.haus", "custom_domain": true },
    { "pattern": "www.xmpp.haus", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
